# ---------------------------------------------------------------
# Nutɔfe API environment. Copy to .env, then: php artisan key:generate
# NEVER commit .env. Production values live only on the server.
# ---------------------------------------------------------------

APP_NAME=Nutofe
# local | testing | staging | production
APP_ENV=local
APP_KEY=
# true adds exception details to 500 responses (never in production)
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC
APP_LOCALE=en
# Reject plain-HTTP requests (true in staging/production, behind TLS)
APP_REQUIRE_HTTPS=false
# Comma-separated reverse-proxy IPs whose X-Forwarded-* headers are trusted (empty = none)
TRUSTED_PROXIES=

# Database (docker compose: host "mysql", port 3306; from the Windows host: 127.0.0.1:3307)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nutofe
DB_USERNAME=nutofe_app
DB_PASSWORD=app_dev_only
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci
# Folder holding the authoritative SQL migrations/seeds (docker layout)
NUTOFE_SQL_PATH=/var/www/database

# Password hashing
HASH_DRIVER=argon2id

# Authentication
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=10
MAX_FAILED_LOGINS=5
LOGIN_LOCKOUT_MINUTES=15
AUTH_ATTEMPTS_PER_MINUTE=10

# Stateless API: no sessions/cookies. File cache (rate limiter); Redis later if needed.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# JSON logs to stderr (docker logs). Use LOG_CHANNEL=daily for files on a VPS.
LOG_CHANNEL=stderr
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
LOG_LEVEL=info

# AI service (Phase 11) — internal URL + shared HMAC secret; the Gemini key lives only in ai-service/.env
AI_SERVICE_URL=http://ai:8090
AI_SERVICE_SECRET=

# Firebase Cloud Messaging: path to the service-account JSON key (outside the repository). Empty = no push.
FCM_CREDENTIALS=
