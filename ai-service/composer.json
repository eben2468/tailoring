{
    "name": "nutofe/ai-service",
    "description": "Nutɔfe AI service: production analytics and the Gemini-backed assistant. Internal only; called by the core API.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": { "Nutofe\\Ai\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Nutofe\\Ai\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": { "sort-packages": true }
}
