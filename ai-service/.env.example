# Nutɔfe AI service — copy to .env (never commit .env).
# Database: a read-only account (SELECT on business tables, INSERT on ai_predictions only).
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nutofe
DB_USERNAME=nutofe_ai
DB_PASSWORD=ai_dev_only

# Shared secret with the core API (AI_SERVICE_SECRET in backend/.env): every request is HMAC-signed.
AI_SERVICE_SECRET=

# Google Gemini (language layer). Empty = the assistant answers from the analytics only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Used in order when the main model's free quota is used up or it is busy
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest
# Daily cap on Gemini calls (free-tier quota protection).
GEMINI_DAILY_LIMIT=200
